<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="悬浮时钟" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="48dp" />
    <Button android:id="@+id/btn_start" android:layout_width="wrap_content" android:layout_height="56dp" android:text="启动悬浮时钟" android:textSize="18sp" android:paddingHorizontal="32dp" />
    <Button android:id="@+id/btn_stop" android:layout_width="wrap_content" android:layout_height="56dp" android:text="关闭悬浮时钟" android:textSize="18sp" android:paddingHorizontal="32dp" android:layout_marginTop="16dp" />
</LinearLayout>